// Generated by qmake from version.h.in at every qmake run - do not edit, do not commit.
// The version lives in a header instead of a -D define so that a new commit recompiles the files that embed it:
// qmake does not rebuild an object when only its DEFINES changed, and only rewrites this file when its content
// changed, so an unchanged version recompiles nothing.
#pragma once

#define APP_VERSION \"$$REMOTE_VERSION\"
